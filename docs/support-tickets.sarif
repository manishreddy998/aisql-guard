              }
            }
          ]
        },
        {
          "ruleId": "ASG003",
          "level": "error",
          "message": {
            "text": "LIMIT or OFFSET sits outside AI.GENERATE. The function runs for the rows that reach the SELECT list, and the clause applies only after that. Filter with WHERE, write those rows to a table, and read that table from the AI function. LIMIT inside the prompt query still processes the input first, and LIMIT on the outer SELECT runs after the function."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "models/marts/ticket_summaries_risky.sql"
                },
                "region": {
                  "startLine": 6,
                  "startColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "ASG001",
          "level": "error",
          "message": {
            "text": "AI.GENERATE does not set an output token cap. The response can run long, and you pay for every output token. Set max_output_tokens on a BigQuery call (STRUCT field or generation_config inside model_params). Set max_tokens on Databricks ai_query and Snowflake AI_COMPLETE."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "models/marts/uncapped_generate.sql"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "ASG002",
          "level": "error",
          "message": {
            "text": "AI.GENERATE does not set a thinking budget or thinking level. Thinking tokens are billed at the output token rate. Set thinking_config.thinking_budget in model_params. Use 0 when the task does not need reasoning. On newer models, set thinking_config.thinking_level instead."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "models/marts/uncapped_generate.sql"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "ASG005",
          "level": "error",
          "message": {
            "text": "AI.GENERATE is in a view. The call runs again on every read, so the bill repeats. Materialize the AI call as a table or an incremental model, and let later models read the stored result. A view runs the call again on every read."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "models/staging/raw_summary_view.sql"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "ASG100",
          "level": "error",
          "message": {
            "text": "ticket_summaries_risky is estimated at 1264.5 USD, which is over its 100 USD budget Lower the row count, cap output and thinking tokens, or raise the budget in aisql-guard.toml."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/support_tickets/aisql-guard.toml"
